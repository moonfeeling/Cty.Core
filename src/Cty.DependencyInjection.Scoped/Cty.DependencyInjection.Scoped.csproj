<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>

	  <!-- NuGet 打包元数据 -->
	  <PackageId>Cty.DependencyInjection.Scoped</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>moonfeeling</Authors>
	  <Description>
		  通用的 .NET DI 作用域管理库，提供 UnitOfWork 句柄与
		  IServiceScopeExecutor 模板执行器，解决 Singleton 捕获
		  Scoped 依赖（captive dependency）问题。
	  </Description>
	  <PackageTags>dependency-injection;di;scope;unitofwork</PackageTags>
	  <RepositoryUrl>https://github.com/yourname/repo</RepositoryUrl>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>

</Project>
